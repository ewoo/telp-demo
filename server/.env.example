# Copy to server/.env and fill in to enable the LIVE Sentinel (real Claude).
# Without this, Fortress runs the scripted fallback — the app and demo still work.
# This key lives SERVER-SIDE ONLY and is never sent to the browser (assume-breach).
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-4-8
# PORT=3001
